{
  "name": "satpay",
  "private": true,
  "description": "SatPay - transparent remittance simulator (CUBO+ The Build Sprint 2026)",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,sql}\"",
    "db:start": "pnpm --filter @satpay/database db:start",
    "db:reset": "pnpm --filter @satpay/database db:reset",
    "db:types": "pnpm --filter @satpay/database db:types"
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  }
}
