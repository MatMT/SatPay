{
  "name": "@satpay/database",
  "version": "0.0.0",
  "private": true,
  "description": "Supabase migrations, seed data and generated types",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "db:start": "supabase start --workdir .",
    "db:stop": "supabase stop --workdir .",
    "db:reset": "supabase db reset --workdir .",
    "db:types": "supabase gen types typescript --local --workdir . > src/database.types.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "supabase": "^2.0.0",
    "typescript": "^5.5.0"
  }
}
